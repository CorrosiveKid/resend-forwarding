# Resend API key with "Full access" (needed to read received emails).
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Signing secret of the webhook you create in Resend (starts with whsec_).
# https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Where forwarded emails go. Comma-separate to forward to several addresses.
FORWARD_TO=you@gmail.com

# Sender used for forwarded emails. Must be on a domain verified in Resend.
# With several receiving domains, list one sender per domain: each forward is
# sent from the address on the same domain as the inbox (else the first one).
FORWARD_FROM=forwarder@yourdomain.com

# Optional: which receiving addresses to forward. Comma-separated.
# Exact addresses (hello@yourdomain.com) or wildcards (*@yourdomain.com).
# Leave empty to forward everything Resend receives.
INBOXES=

# Optional: set to "false" to skip the small "Forwarded message" header block.
FORWARD_HEADER=true
